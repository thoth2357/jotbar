{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jotbar",
  "version": "0.1.0",
  "identifier": "dev.jotbar.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "jotbar",
        "width": 440,
        "height": 600,
        "minWidth": 300,
        "minHeight": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "msi"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
